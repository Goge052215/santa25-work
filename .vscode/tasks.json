{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "clang object build a.cpp (OpenMP)",
            "type": "shell",
            "command": "/usr/bin/clang++",
            "args": [
                "-std=gnu++14",
                "-g",
                "-Xpreprocessor",
                "-fopenmp",
                "-I",
                "/opt/homebrew/opt/libomp/include",
                "-c",
                "${workspaceFolder}/claude/a.cpp",
                "-o",
                "${workspaceFolder}/claude/a.o"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": [
                "$gcc"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "clang build a.cpp (OpenMP)",
            "type": "shell",
            "command": "/usr/bin/clang++",
            "args": [
                "-std=gnu++14",
                "-g",
                "-Xpreprocessor",
                "-fopenmp",
                "-I",
                "/opt/homebrew/opt/libomp/include",
                "${workspaceFolder}/claude/a.cpp",
                "-L",
                "/opt/homebrew/opt/libomp/lib",
                "-lomp",
                "-Wl,-rpath,/opt/homebrew/opt/libomp/lib",
                "-o",
                "${workspaceFolder}/claude/a"
            ],
            "group": "build",
            "problemMatcher": [
                "$gcc"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "gcc-14 build a.cpp (OpenMP)",
            "type": "shell",
            "command": "g++-14",
            "args": [
                "-std=gnu++14",
                "-g",
                "-O3",
                "-fopenmp",
                "${workspaceFolder}/claude/a.cpp",
                "-o",
                "${workspaceFolder}/claude/a_gcc"
            ],
            "group": "build",
            "problemMatcher": [
                "$gcc"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "type": "cppbuild",
            "label": "C/C++: clang++ build active file",
            "command": "/usr/bin/clang++",
            "args": [
                "-fcolor-diagnostics",
                "-fansi-escape-codes",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}",
                "-Xpreprocessor",
                "-fopenmp",
                "-I",
                "/opt/homebrew/opt/libomp/include",
                "-L",
                "/opt/homebrew/opt/libomp/lib",
                "-lomp",
                "-Wl,-rpath,/opt/homebrew/opt/libomp/lib"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        }
    ]
}
